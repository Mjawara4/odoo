<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!--
        Fashion product attributes.
        create_variant="always" means each size/color combo gets its own
        stock-trackable variant (product.product), which is required for
        per-SKU inventory control.
    -->

    <!-- =====================================================================
         Clothing Size  (XS → 3XL)
         Used by: Tops, Bottoms, Dresses, Underwear
         ===================================================================== -->
    <record id="pa_clothing_size" model="product.attribute">
        <field name="name">Clothing Size</field>
        <field name="sequence">10</field>
        <field name="display_type">pills</field>
        <field name="create_variant">always</field>
    </record>

    <record id="pav_cs_xs" model="product.attribute.value">
        <field name="name">XS</field>
        <field name="sequence">1</field>
        <field name="attribute_id" ref="pa_clothing_size"/>
    </record>
    <record id="pav_cs_s" model="product.attribute.value">
        <field name="name">S</field>
        <field name="sequence">2</field>
        <field name="attribute_id" ref="pa_clothing_size"/>
    </record>
    <record id="pav_cs_m" model="product.attribute.value">
        <field name="name">M</field>
        <field name="sequence">3</field>
        <field name="attribute_id" ref="pa_clothing_size"/>
    </record>
    <record id="pav_cs_l" model="product.attribute.value">
        <field name="name">L</field>
        <field name="sequence">4</field>
        <field name="attribute_id" ref="pa_clothing_size"/>
    </record>
    <record id="pav_cs_xl" model="product.attribute.value">
        <field name="name">XL</field>
        <field name="sequence">5</field>
        <field name="attribute_id" ref="pa_clothing_size"/>
    </record>
    <record id="pav_cs_2xl" model="product.attribute.value">
        <field name="name">2XL</field>
        <field name="sequence">6</field>
        <field name="attribute_id" ref="pa_clothing_size"/>
    </record>
    <record id="pav_cs_3xl" model="product.attribute.value">
        <field name="name">3XL</field>
        <field name="sequence">7</field>
        <field name="attribute_id" ref="pa_clothing_size"/>
    </record>

    <!-- =====================================================================
         Shoe Size  (EU 36 → 45)
         Used by: Shoes
         create_variant="always" → separate stock per shoe size
         ===================================================================== -->
    <record id="pa_shoe_size" model="product.attribute">
        <field name="name">Shoe Size</field>
        <field name="sequence">20</field>
        <field name="display_type">pills</field>
        <field name="create_variant">always</field>
    </record>

    <record id="pav_ss_36" model="product.attribute.value">
        <field name="name">36</field>
        <field name="sequence">1</field>
        <field name="attribute_id" ref="pa_shoe_size"/>
    </record>
    <record id="pav_ss_37" model="product.attribute.value">
        <field name="name">37</field>
        <field name="sequence">2</field>
        <field name="attribute_id" ref="pa_shoe_size"/>
    </record>
    <record id="pav_ss_38" model="product.attribute.value">
        <field name="name">38</field>
        <field name="sequence">3</field>
        <field name="attribute_id" ref="pa_shoe_size"/>
    </record>
    <record id="pav_ss_39" model="product.attribute.value">
        <field name="name">39</field>
        <field name="sequence">4</field>
        <field name="attribute_id" ref="pa_shoe_size"/>
    </record>
    <record id="pav_ss_40" model="product.attribute.value">
        <field name="name">40</field>
        <field name="sequence">5</field>
        <field name="attribute_id" ref="pa_shoe_size"/>
    </record>
    <record id="pav_ss_41" model="product.attribute.value">
        <field name="name">41</field>
        <field name="sequence">6</field>
        <field name="attribute_id" ref="pa_shoe_size"/>
    </record>
    <record id="pav_ss_42" model="product.attribute.value">
        <field name="name">42</field>
        <field name="sequence">7</field>
        <field name="attribute_id" ref="pa_shoe_size"/>
    </record>
    <record id="pav_ss_43" model="product.attribute.value">
        <field name="name">43</field>
        <field name="sequence">8</field>
        <field name="attribute_id" ref="pa_shoe_size"/>
    </record>
    <record id="pav_ss_44" model="product.attribute.value">
        <field name="name">44</field>
        <field name="sequence">9</field>
        <field name="attribute_id" ref="pa_shoe_size"/>
    </record>
    <record id="pav_ss_45" model="product.attribute.value">
        <field name="name">45</field>
        <field name="sequence">10</field>
        <field name="attribute_id" ref="pa_shoe_size"/>
    </record>

    <!-- =====================================================================
