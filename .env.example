# Fashion POS — Environment Variables
# Copy this to .env and fill in real values:
#   cp .env.example .env
# The install.sh script generates .env automatically with a random password.

DB_USER=odoo
DB_PASSWORD=change_this_to_a_strong_random_password
DB_NAME=fashion_gambia

# Optional: Telegram health alerts (set both or leave both empty)
# 1. Create a bot at https://t.me/BotFather → copy the token
# 2. Get your chat ID from https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
